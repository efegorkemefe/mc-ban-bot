# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Optional: register slash commands to this single guild for near-instant updates
# during development. Leave blank to register globally (can take up to ~1 hour).
GUILD_ID=

# ── Branding (optional) ───────────────────────────────────────────────────────
BRAND_NAME=SovietCraft          # Name shown across all embeds
BRAND_COLOR=#5865f2             # Accent colour for panel / info embeds (hex)
BRAND_ICON_URL=                 # Optional icon URL for embed author/footer lines

# Channel for ban embeds
BAN_LOG_CHANNEL_ID=your_ban_log_channel_id_here
# Optional separate channel to archive ban evidence screenshots in. Evidence is
# re-hosted here so the stored link never expires. Defaults to the ban log channel.
EVIDENCE_ARCHIVE_CHANNEL_ID=
# Channel for war/raid embeds
WAR_LOG_CHANNEL_ID=your_war_log_channel_id_here

# Comma-separated, no spaces — e.g. 123456789,987654321,111222333
# Roles pinged for HIGH / CRITICAL / PERMANENT bans (Developer, Moderator, Admin etc.)
SENIOR_ROLE_IDS=

# ── Google Sheets ─────────────────────────────────────────────────────────────
SPREADSHEET_ID=your_google_spreadsheet_id_here
BAN_SHEET_NAME=Bans
WAR_SHEET_NAME=War & Raid Approvals

# ── Ticket system ─────────────────────────────────────────────────────────────
# Staff roles: can run EVERY ticket / whitelist command (comma-separated IDs, no spaces).
# If blank, anyone with Manage Server is treated as staff.
STAFF_ROLE_IDS=
# Senior staff can always speak even in CLAIMED tickets, and are pinged for Staff
# Reports + whitelist appeals. (Reuses SENIOR_ROLE_IDS from the ban config above.)
# Channel where closed-ticket transcripts + summaries are posted.
TICKET_LOG_CHANNEL_ID=your_ticket_log_channel_id_here
# Minimum days a member must be in the server before opening a Staff Application.
STAFF_APP_MIN_DAYS=7
# Ticket inactivity auto-close (hours). Leave 0/unset to disable. When a ticket
# has no human activity for WARN hours it gets a warning; at INACTIVITY hours it
# is auto-closed (transcript saved). INACTIVITY must be > WARN.
TICKET_INACTIVITY_HOURS=0
TICKET_INACTIVITY_WARN_HOURS=0

# ── Whitelist ─────────────────────────────────────────────────────────────────
# Role granted to approved applicants (AI auto-approve or /wl-accept).
MEMBER_ROLE_ID=your_member_role_id_here
# "Verified" role granted alongside the member role on approval. Defaults to the
# member role when blank, so it's a no-op until you create a distinct role.
VERIFIED_ROLE_ID=
# Anthropic API key for AI whitelist review. Blank = manual staff review only.
ANTHROPIC_API_KEY=
# Google Sheet tab that records verified Minecraft accounts (IGN ↔ UUID ↔ Discord).
# Created automatically on first write if it doesn't exist.
VERIFIED_SHEET_NAME=Verified Players

# ── Moderation / utility ──────────────────────────────────────────────────────
# Warnings at/above this count make /warn suggest a ban (ephemeral hint only).
WARN_BAN_THRESHOLD=3
# Hours an OPEN, UNCLAIMED ban appeal may sit before a reminder is posted to the
# ban-log channel (checked every 12h). Set 0 to disable appeal reminders.
APPEAL_REMINDER_HOURS=48

# ── Alt detection & flags ─────────────────────────────────────────────────────
# Whitelist applicants whose Discord account is younger than this (days) are
# flagged for staff (the application still proceeds — it's a flag, not a block).
MIN_ACCOUNT_AGE_DAYS=30
# Flag a new whitelist applicant if any ban ended or was lifted within this many
# days (possible ban-evasion timing).
REJOIN_WINDOW_DAYS=14

# ── Staff Roster ──────────────────────────────────────────────────────────────
# Three-tier staff model. STAFF_ROLE_IDS (tier 1) + SENIOR_ROLE_IDS (tier 2) are
# defined above; add Super Staff / Admin (tier 3) here. Comma-separated, no spaces.
# REQUIRED to onboard Super Staff — if blank, /roster-onboard can't grant a Super
# role (server admins still count as tier 3 via the Administrator permission).
SUPER_ROLE_IDS=
# Role applied while a staffer is suspended (tier roles are stripped). Configure
# this role's channel permissions yourself so suspended staff can VIEW but not
# SEND in staff channels — the bot only assigns/removes the role.
SUSPENDED_ROLE_ID=
# Channel for staff discipline / LOA / roster logs. Blank = logging skipped.
STAFF_LOG_CHANNEL_ID=
# Permanent quota-exemption role (opt-in). Blank = NO ONE is auto-exempt by role.
# Do NOT point this at MEMBER_ROLE_ID — staff hold the member role too, which would
# exempt everyone and make the weekly quota meaningless.
STAFF_EXEMPT_ROLE_ID=
# Active warns / strikes at/above these auto-alert Super Staff (no auto-demotion).
STAFF_WARN_THRESHOLD=3
STAFF_STRIKE_THRESHOLD=2
# Weekly activity quotas. 0 = not tracked. A member passes the week only if every
# non-zero quota is met. With all 0 (default), no one is ever auto-struck.
WEEKLY_QUOTA_BANS=0
WEEKLY_QUOTA_WARS=0
WEEKLY_QUOTA_TICKETS=0
WEEKLY_QUOTA_WARNS=0
# Promotion-eligibility thresholds (passive flag only — the bot never auto-promotes).
PROMO_MIN_TENURE_DAYS=30
PROMO_QUOTA_WEEKS_REQUIRED=6
PROMO_QUOTA_WEEKS_WINDOW=8
PROMO_MAX_WARNS=2
PROMO_MIN_LIFETIME_ACTIONS=0
# Read-only Google-Sheet mirror of the roster. LEAVE ROSTER_SHEET_NAME BLANK until
# you create the "Staff Roster" tab in the spreadsheet — the API can't write to a
# tab that doesn't exist, so the mirror stays disabled (and never errors) while blank.
ROSTER_SHEET_NAME=
ROSTER_MIRROR_INTERVAL_MINUTES=60
# Row where real roster entries begin (rows 1-2 title/header, 3-5 examples, 6 divider).
ROSTER_DATA_START_ROW=7
