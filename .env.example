# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Channel for ban embeds
BAN_LOG_CHANNEL_ID=your_ban_log_channel_id_here
# Channel for war/raid embeds
WAR_LOG_CHANNEL_ID=your_war_log_channel_id_here

# Comma-separated, no spaces — e.g. 123456789,987654321,111222333
# Roles pinged for HIGH / CRITICAL / PERMANENT bans (Developer, Moderator, Admin etc.)
SENIOR_ROLE_IDS=

# ── Google Sheets ─────────────────────────────────────────────────────────────
SPREADSHEET_ID=your_google_spreadsheet_id_here
BAN_SHEET_NAME=Bans
WAR_SHEET_NAME=War & Raid Approvals
