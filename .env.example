# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Optional: register slash commands to this single guild for near-instant updates
# during development. Leave blank to register globally (can take up to ~1 hour).
GUILD_ID=

# ── Branding (optional) ───────────────────────────────────────────────────────
BRAND_NAME=SovietCraft          # Name shown across all embeds
BRAND_COLOR=#5865f2             # Accent colour for panel / info embeds (hex)
BRAND_ICON_URL=                 # Optional icon URL for embed author/footer lines

# Channel for ban embeds
BAN_LOG_CHANNEL_ID=your_ban_log_channel_id_here
# Optional separate channel to archive ban evidence screenshots in. Evidence is
# re-hosted here so the stored link never expires. Defaults to the ban log channel.
EVIDENCE_ARCHIVE_CHANNEL_ID=
# Channel for war/raid embeds
WAR_LOG_CHANNEL_ID=your_war_log_channel_id_here

# Comma-separated, no spaces — e.g. 123456789,987654321,111222333
# Roles pinged for HIGH / CRITICAL / PERMANENT bans (Developer, Moderator, Admin etc.)
SENIOR_ROLE_IDS=

# ── Google Sheets ─────────────────────────────────────────────────────────────
SPREADSHEET_ID=your_google_spreadsheet_id_here
BAN_SHEET_NAME=Bans
WAR_SHEET_NAME=War & Raid Approvals

# ── Ticket system ─────────────────────────────────────────────────────────────
# Staff roles: can run EVERY ticket / whitelist command (comma-separated IDs, no spaces).
# If blank, anyone with Manage Server is treated as staff.
STAFF_ROLE_IDS=
# Senior staff can always speak even in CLAIMED tickets, and are pinged for Staff
# Reports + whitelist appeals. (Reuses SENIOR_ROLE_IDS from the ban config above.)
# Channel where closed-ticket transcripts + summaries are posted.
TICKET_LOG_CHANNEL_ID=your_ticket_log_channel_id_here
# Minimum days a member must be in the server before opening a Staff Application.
STAFF_APP_MIN_DAYS=7
# Ticket inactivity auto-close (hours). Leave 0/unset to disable. When a ticket
# has no human activity for WARN hours it gets a warning; at INACTIVITY hours it
# is auto-closed (transcript saved). INACTIVITY must be > WARN.
TICKET_INACTIVITY_HOURS=0
TICKET_INACTIVITY_WARN_HOURS=0

# ── Whitelist ─────────────────────────────────────────────────────────────────
# Role granted to approved applicants (AI auto-approve or /wl-accept).
MEMBER_ROLE_ID=your_member_role_id_here
# Anthropic API key for AI whitelist review. Blank = manual staff review only.
ANTHROPIC_API_KEY=
